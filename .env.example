# Local PostgreSQL database used only for demo data.
DATABASE_URL="postgresql://exchange:exchange_dev_password@localhost:5432/exchange_demo?schema=public"

# Redis stores shared rate-limit counters (and is reserved for future real-time fan-out/background work).
REDIS_URL="redis://localhost:6379"

# Required in production: base64-encoded 32-byte key for encrypting authenticator secrets.
# Local development automatically creates .local-secrets/data-encryption.key when this is omitted.
# DATA_ENCRYPTION_KEY=""

# Transactional email provider (required in production). See docs/EMAIL_SETUP.md for full instructions.
# Option 1: SendGrid (recommended)
# EMAIL_PROVIDER="sendgrid"
# EMAIL_API_KEY="SG.your_sendgrid_key_here"
# EMAIL_FROM="Nexa Exchange <noreply@example.com>"

# Option 2: AWS SES
# EMAIL_PROVIDER="aws-ses"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIA1234567890ABCDEF"
# AWS_SECRET_ACCESS_KEY="your_secret_key_here"
# EMAIL_FROM="Nexa Exchange <noreply@example.com>"

# Option 3: Generic HTTP API
# EMAIL_PROVIDER="generic"
# EMAIL_API_URL="https://api.example.com/send"
# EMAIL_API_KEY="your_api_key_here"
# EMAIL_FROM="Nexa Exchange <noreply@example.com>"

# If no EMAIL_PROVIDER is set, email will run in local demo mode (logged to console).

# Required in production behind the HTTPS reverse proxy.
# TRUST_PROXY=1

# Required in production to protect the Prometheus-compatible /metrics endpoint.
# MONITORING_TOKEN=""

# Production backup encryption and retention. Keep this key separate from backups.
# BACKUP_ENCRYPTION_KEY=""
# BACKUP_RETENTION_DAYS=14
# OFFSITE_BACKUP_DIRECTORY=""
