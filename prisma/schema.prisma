generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRADER
  ADMIN
}

enum Asset {
  BTC
  USDT
}

enum LedgerAccountType {
  AVAILABLE
  LOCKED
  SYSTEM_ISSUANCE
  FEE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}


// NOTE: this Prisma schema documents the intended production data model
// (PRODUCT_REQUIREMENTS.md section 7). The running demo server currently
// bootstraps and queries the same shape with raw SQL (server/ledger.mjs)
// rather than Prisma Migrate — adopting Prisma Migrate is a follow-up task,
// not done yet. Keep these two in sync by hand until then.

// A ledger account is never a mutable balance column — its balance is
// always derived by summing LedgerEntry rows. System accounts (e.g.
// SYSTEM_ISSUANCE) have userId = null and are singletons per (asset, type).
model LedgerAccount {
  id          String            @id @default(cuid())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       Asset
  accountType LedgerAccountType
  createdAt   DateTime          @default(now())
  entries     LedgerEntry[]

  @@unique([userId, asset, accountType])
}

// One row per debit or credit. Entries sharing a groupId must sum to zero
// per asset — that invariant is enforced in code (server/ledger.mjs),
// checked before any row is written.
model LedgerEntry {
  id              String          @id @default(cuid())
  groupId         String
  ledgerAccountId String
  ledgerAccount   LedgerAccount   @relation(fields: [ledgerAccountId], references: [id])
  direction       LedgerDirection
  amount          Decimal         @db.Decimal(28, 8)
  reason          String
  relatedType     String?
  relatedId       String?
  createdAt       DateTime        @default(now())

  @@index([ledgerAccountId])
  @@index([groupId])
}

// Immutable, append-only record of security- and admin-relevant events.
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum OrderType {
  LIMIT
  MARKET
}

model Market {
  id            String   @id @default(cuid())
  baseCurrency  String   // e.g. "BTC"
  quoteCurrency String   // e.g. "USDT"
  symbol        String   @unique // e.g. "BTC/USDT"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
  trades Trade[]

  @@index([isActive])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketId      String
  market        Market      @relation(fields: [marketId], references: [id])
  side          OrderSide
  type          OrderType
  price         Decimal?    @db.Decimal(28, 8) // NULL for market orders
  quantity      Decimal     @db.Decimal(28, 8)
  filledAmount  Decimal     @db.Decimal(28, 8) @default(0)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  trades Trade[]

  @@index([userId])
  @@index([marketId])
  @@index([status])
  @@index([createdAt])
}

model Trade {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])
  counterOrderId String? // Matching order (if any)
  price      Decimal  @db.Decimal(28, 8)
  quantity   Decimal  @db.Decimal(28, 8)
  fee        Decimal  @db.Decimal(28, 8)
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([marketId])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(TRADER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerAccounts LedgerAccount[]
  auditEvents    AuditEvent[]
  orders         Order[]
}
