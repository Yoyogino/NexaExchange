STAGING_DOMAIN=exchange-staging.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-password
POSTGRES_MIGRATION_PASSWORD=replace-with-a-third-long-random-password
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Transactional email - configure one of:
# SendGrid:
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG.replace-with-sendgrid-key
EMAIL_FROM=Nexa Exchange <noreply@staging.example.com>

# OR AWS SES:
# EMAIL_PROVIDER=aws-ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA1234567890ABCDEF
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
# EMAIL_FROM=Nexa Exchange <noreply@staging.example.com>

# OR a generic HTTP email provider:
# EMAIL_PROVIDER=generic
# EMAIL_API_URL=https://mail-provider.example.com/send
# EMAIL_API_KEY=replace-with-provider-key
# EMAIL_FROM=Nexa Exchange <noreply@staging.example.com>

MONITORING_TOKEN=replace-with-a-long-random-monitoring-token
STAGING_SMOKE_EMAIL=smoke-account@staging.example.com
STAGING_SMOKE_PASSWORD=replace-with-a-dedicated-long-random-password

# Encrypted staging backups. The offsite path must be a mounted/synced directory on the host.
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-base64-encoded-32-byte-key
OFFSITE_BACKUP_DIRECTORY=/mnt/secure-offsite/nexa-staging
BACKUP_RETENTION_DAYS=14

# Used only by `npm run validate:staging` from the deployment workstation.
STAGING_URL=https://exchange-staging.example.com
